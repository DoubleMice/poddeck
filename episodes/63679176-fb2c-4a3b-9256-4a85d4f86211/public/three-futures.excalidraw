    {"id":"w1","type":"rectangle","x":30,"y":70,"width":215,"height":210,"angle":0,"strokeColor":"#e03131","backgroundColor":"#ffc9c9","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1.5,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":2,"version":1,"versionNonce":2,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"w1t","type":"text","x":40,"y":80,"width":195,"height":190,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":3,"version":1,"versionNonce":3,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"fontSize":13,"fontFamily":1,"text":"世界一\n模型停止变强\n\n用已有能力\n服务全人类\n\n可能性非常小\n（除非电力/算力\n突然消失）","textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"世界一\n模型停止变强\n\n用已有能力\n服务全人类\n\n可能性非常小\n（除非电力/算力\n突然消失）","lineHeight":1.25,"baseline":178},
